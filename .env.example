# Environment identifier: local | dev | prod
ENV=local

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
WEB_APP_URL=http://localhost:3000

# Notification tracking — must match NOTIFY_LOG_SECRET set on the notify-log-received edge function
NOTIFY_LOG_SECRET=your-secret-here

# Debug-only: super-owner "impersonate" login. Must match the web-app ADMIN_API_KEY
# of the environment you point at (e.g. set it in .env.prod to impersonate prod users
# from a debug build). Leave blank in normal dev — the impersonate screen is kDebugMode-only.
ADMIN_API_KEY=
