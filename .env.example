# Environment identifier: local | dev | prod
ENV=local

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
WEB_APP_URL=http://localhost:3000

# Notification tracking — must match NOTIFY_LOG_SECRET set on the notify-log-received edge function
NOTIFY_LOG_SECRET=your-secret-here
