# Copy this file to fastlane/.env (gitignored) and fill in your real values.
# fastlane loads fastlane/.env automatically.
#
# From App Store Connect -> Users and Access -> Integrations/Keys:
#   ASC_KEY_ID    = the Key ID of the App Store Connect API key
#   ASC_ISSUER_ID = the Issuer ID shown above the keys list
# The matching AuthKey_XXXX.p8 file must be saved as fastlane/AuthKey.p8 (gitignored).
ASC_KEY_ID=
ASC_ISSUER_ID=
